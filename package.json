{
  "name": "orion-aic",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4311",
    "prebuild": "node scripts/source-archive.mjs",
    "build": "vite build && node scripts/service-worker.mjs",
    "start": "node server/index.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4311",
    "check": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "format": "prettier --write src shared server scripts tests e2e docs *.json *.md index.html vite.config.ts .github/workflows",
    "format:check": "prettier --check src shared server scripts tests e2e docs *.json *.md index.html vite.config.ts .github/workflows",
    "lan": "npm run build && node server/lan.mjs",
    "lan:serve": "node server/lan.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "motion": "^13.4.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "selfsigned": "^5.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "description": "orion aic : journal d’intervention, messages, carte, moyens, équipe et réseau radio pour l’aide à la conduite. Local, chiffré, synchronisé sans base de données."
}
